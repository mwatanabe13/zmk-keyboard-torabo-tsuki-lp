// torabo-tsuki LP (M size) keymap — ported from Keyball44 (Remap, US layout)
// Replace config/keymap.keymap in your fork of
// https://github.com/sekigon-gonnoc/zmk-keyboard-torabo-tsuki-lp
//
// The keymap covers the full shared matrix (L-size, 66 positions).
// Positions that don't physically exist on M size are simply ignored,
// so the top number row and the two inner keys per row are padded.

#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// ------------------------------------------------------------
// Auto-mouse: moving the trackball momentarily activates layer 2
// for 1000 ms. Pressing any key ends it early, EXCEPT the
// excluded positions below (mouse buttons + modifiers), so you
// can click and Ctrl/Shift+click without dropping out.
// ------------------------------------------------------------
&zip_temp_layer {
    excluded-positions = <
        30 31   // inner LCLK / RCLK keys (row 3)
        33 34   // J / K = Mouse Btn1 / Btn2 on layer 2
        38 51   // left / right Shift
        52 53   // left Ctrl thumb keys
    >;
};

&pointing_listener {
    input-processors = <&zip_temp_layer 2 1000>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Hold Space (layer 2) + press F+G together -> clear all BT bonds
        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ------------------------------------------------------------
        // Layer 0: Base (Keyball44 Layer 0)
        // ------------------------------------------------------------
        layer_0 {
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&kp ESC   &kp Q &kp W &kp E &kp R &kp T                    &kp Y &kp U &kp I &kp O &kp P &kp BSPC
&kp TAB   &kp A &kp S &kp D &kp F &kp G &mkp LCLK &mkp RCLK &kp H &kp J &kp K &kp L &kp SEMI &lt 3 RET
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp SPACE &kp RET   &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
&kp LCTRL &kp LCTRL &kp LGUI &kp LALT &mo 1 &lt 2 SPACE &mt LSHFT LANGUAGE_2 &mt RSHFT LANGUAGE_1 &mo 3 &kp BSPC &kp RALT &kp RGUI &kp RCTRL &kp RCTRL
            >;
        };

        // ------------------------------------------------------------
        // Layer 1: Numbers & symbols (Keyball44 Layer 1)
        //   Left home row = 1-5, left bottom row = 6-0
        //   Mouse Btn1/Btn2 on J/K
        // ------------------------------------------------------------
        layer_1 {
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &kp LBKT &kp LGUI &kp EQUAL &trans           &kp RBKT &kp MINUS &kp LALT &trans &trans &trans
&trans &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &trans &trans    &kp SQT &mkp LCLK &mkp RCLK &trans &trans &trans
&trans &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &trans &trans    &kp BSLH &kp GRAVE &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        // ------------------------------------------------------------
        // Layer 2: identical to Layer 1 (as in the original cheat sheet),
        // reached by holding Space
        // ------------------------------------------------------------
        layer_2 {
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &kp LBKT &kp LGUI &kp EQUAL &trans           &kp RBKT &kp MINUS &kp LALT &trans &trans &trans
&trans &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &trans &trans    &kp SQT &mkp LCLK &mkp RCLK &trans &trans &trans
&trans &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &trans &trans    &kp BSLH &kp GRAVE &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        // ------------------------------------------------------------
        // Layer 3: Shifted symbols + navigation (Keyball44 Layer 3)
        //   Left home row = !@#$%, left bottom = ^&*()
        //   Arrows on I/J/K/L, Del on O
        // ------------------------------------------------------------
        layer_3 {
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &kp LS(LBKT) &trans &kp LS(EQUAL) &trans     &kp LS(RBKT) &kp LS(MINUS) &kp UP &kp DEL &trans &trans
&trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &trans &trans &kp DQT &kp LEFT &kp DOWN &kp RIGHT &kp COLON &trans
&trans &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &trans &trans &kp PIPE &kp TILDE &kp LT &kp GT &kp QMARK &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
